# Copy this file to `.env` (gitignored) and fill in real values before running
# `docker compose up`. Every variable here is referenced by docker-compose.yml.
# See docs/superpowers/specs/2026-07-18-phase8-docker-ci-azure-design.md §3 for the full
# env-var/config-key matrix this file documents.

# --- SQL Server (main app) — SA password, shared by the sqlserver container. Required. ---
MSSQL_SA_PASSWORD=Ch4ngeMe_DevOnly!

# --- SQL Server sidecar dedicated to the Service Bus emulator (separate instance/password by
# convention — matches services/fashionsaas-tryon/docker-compose.servicebus.yml). Required. ---
SERVICEBUS_SQL_SA_PASSWORD=Ch4ngeMe_DevOnly!

# =============================================================================
# api (FashionSaaS.API)
# =============================================================================

# Required. Server=sqlserver;Database=AiClothing;User Id=sa;Password=<matches MSSQL_SA_PASSWORD above>;Encrypt=False;TrustServerCertificate=True
API_DB_CONNECTION_STRING=Server=sqlserver;Database=AiClothing;User Id=sa;Password=Ch4ngeMe_DevOnly!;Encrypt=False;TrustServerCertificate=True

# Required. HS256 signing key, >= 32 characters. MUST be identical to the value used by
# tryon-api's JWT_SECRET below — the try-on service validates JWTs issued by the main API.
JWT_SECRET=REPLACE-WITH-A-REAL-32-CHAR-MINIMUM-SECRET

# Required. AES key backing EncryptionSettings:BankFieldKey (bank-field column encryption).
ENCRYPTION_BANK_FIELD_KEY=REPLACE-WITH-A-REAL-32-BYTE-AES-KEY

# Optional — has a code default (JwtSettings:Issuer = "FashionSaaS", :Audience = "FashionSaaSUsers").
# Not surfaced here; override only if you need non-default values (add
# JwtSettings__Issuer / JwtSettings__Audience to docker-compose.yml's api.environment block first).

# Required only if the app needs to send real email (SmtpSettings:Host/Port/From have code
# defaults — smtp.gmail.com/587/noreply@fashionsaas.com — only Username/Password have no default).
SMTP_USERNAME=
SMTP_PASSWORD=

# Required for image upload features — no committed default, must be supplied.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — has a code default (Cors:AllowedOrigins:0 = "http://localhost:4200" in
# appsettings.json). Set explicitly here so the api container's CORS allow-list matches wherever
# the storefront container is actually reachable in this compose stack.
STOREFRONT_ORIGIN=http://localhost:4200

# =============================================================================
# tryon-api (FashionSaaS.TryOn.Api)
# =============================================================================

# Required. Server=sqlserver;Database=TryOnDb;User Id=sa;Password=<matches MSSQL_SA_PASSWORD above>;Encrypt=False;TrustServerCertificate=True
TRYON_DB_CONNECTION_STRING=Server=sqlserver;Database=TryOnDb;User Id=sa;Password=Ch4ngeMe_DevOnly!;Encrypt=False;TrustServerCertificate=True

# Required. Google Gemini API key — no committed default (only a placeholder exists in
# gitignored dev appsettings).
GEMINI_API_KEY=REPLACE-WITH-A-REAL-GEMINI-API-KEY

# Required. Local/dev value points at the servicebus-emulator container started by this compose
# file; a real Azure Service Bus connection string is needed for anything beyond local dev.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Optional — has code defaults: GeminiSettings:BaseUrl ("https://generativelanguage.googleapis.com"),
# :Model ("gemini-2.5-flash-image"), :AllowedGarmentImageHosts:0 ("res.cloudinary.com"),
# ServiceBusSettings:TopicName ("tryon-events"), JwtSettings:Issuer/:Audience (see above).
# Not surfaced here; override only if you need non-default values.

# =============================================================================
# storefront (Angular build args, baked into the image at build time — see D7; there is no
# runtime env-var injection for this container)
# =============================================================================

STOREFRONT_API_BASE_URL=http://localhost:5000/api
STOREFRONT_TRYON_API_BASE_URL=http://localhost:5050/api
